{
  "manifest_version": 3,
  "name": "Picture In Picture",
  "version": "1.1.0",
  "description": "Картинка в картинке для видео: плавающая кнопка на YouTube, VK Видео, Rutube, Dzen и включение по клику на иконку расширения (Alt+P).",
  "minimum_chrome_version": "102",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://vk.com/*",
    "https://vk.ru/*",
    "https://rutube.ru/*",
    "https://dzen.ru/*",
    "https://zen.ru/*"
  ],
  "action": {
    "default_title": "Картинка в картинке (Alt+P)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content/youtube.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://vk.com/*",
        "https://vk.ru/*",
        "https://rutube.ru/*",
        "https://dzen.ru/*",
        "https://zen.ru/*"
      ],
      "js": ["content/video-sites.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+P"
      },
      "description": "Включить/выключить режим Картинка в картинке"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
